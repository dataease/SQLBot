# syntax=docker/dockerfile:1
ARG PYTHON_IMAGE=python:3.11-slim-bookworm
ARG NODE_IMAGE=node:22-bookworm-slim
ARG SQLBOT_PG_BASE_IMAGE=pg-base

FROM ${PYTHON_IMAGE} AS python-builder
ARG PIP_VERSION=26.3
# Refresh the installed pip and the wheel used by ensurepip to seed new venvs.
RUN set -eu; \
    wheels="$(mktemp -d)"; \
    python -m pip --isolated download --no-cache-dir --only-binary=:all: --no-deps \
        --index-url https://pypi.org/simple --dest "$wheels" "pip==$PIP_VERSION"; \
    python -m pip --isolated install --no-index --no-cache-dir "$wheels"/pip-*.whl; \
    ensurepip_dir="$(python -c 'from pathlib import Path; import ensurepip; print(Path(ensurepip.__file__).parent)')"; \
    rm "$ensurepip_dir"/_bundled/pip-*.whl; \
    mv "$wheels"/pip-*.whl "$ensurepip_dir/_bundled/"; \
    sed -i "s/^_PIP_VERSION = .*/_PIP_VERSION = \"$PIP_VERSION\"/" "$ensurepip_dir/__init__.py"; \
    test "$(python -m ensurepip --version)" = "pip $PIP_VERSION"; \
    rmdir "$wheels"

FROM ${NODE_IMAGE} AS node-runtime

FROM ${SQLBOT_PG_BASE_IMAGE} AS graphics-toolchain
# Build from the signed Bookworm source index in a disposable stage.
RUN sed 's/^Types: deb$/Types: deb-src/' /etc/apt/sources.list.d/debian.sources \
        > /etc/apt/sources.list.d/sqlbot-src.sources \
    && apt-get -o APT::Update::Error-Mode=any update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl dpkg-dev \
    && DEBIAN_FRONTEND=noninteractive apt-get build-dep -y --no-install-recommends harfbuzz gdk-pixbuf

FROM graphics-toolchain AS graphics-builder
COPY docker/build-graphics.sh /tmp/build-graphics.sh
RUN sh /tmp/build-graphics.sh

FROM ${SQLBOT_PG_BASE_IMAGE}

COPY --from=python-builder /usr/local/ /usr/local/
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=ghcr.io/astral-sh/uv:0.7.8 /uv /uvx /bin/

# Add the libraries needed by Python, chart rendering and database clients.
RUN --mount=type=bind,from=graphics-builder,source=/out,target=/tmp/graphics \
    apt-get -o APT::Update::Error-Mode=any update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl wait-for-it supervisor tzdata unzip \
        libaio1 libbz2-1.0 libcairo2 libexpat1 libffi8 libfreetype6 \
        libgdbm6 libgdbm-compat4 libgif7 libjpeg62-turbo liblzma5 \
        libncursesw6 libpango-1.0-0 libpangocairo-1.0-0 libpixman-1-0 \
        libpq5 libreadline8 librsvg2-2 libsqlite3-0 libssl3 libuuid1 zlib1g \
        /tmp/graphics/*.deb \
    && rm -rf /var/lib/apt/lists/* \
    && python -c 'import bz2, ctypes, lzma, readline, sqlite3, ssl' \
    && node --version \
    && test "$PG_MAJOR" = 17 \
    && test "$PGDATA" = /var/lib/postgresql/data \
    && ! dpkg-query -W libtiff6 2>/dev/null \
    && test -z "$(find /usr/lib -name 'libpixbufloader-tiff.so' -o -name 'libtiff.so*')" \
    && test -f "$(pg_config --sharedir)/extension/vector.control"

ARG TARGETARCH
ENV DB_CLIENT=/opt/sqlbot/db_client
ENV DM_HOME=/opt/dmdbms
ENV LD_LIBRARY_PATH=/opt/dmdbms/bin:/opt/sqlbot/db_client/oracle_instant_client

# Install the existing Oracle client and license validator for the target CPU.
# The application image supplies the DM client through its dmPython wheel.
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) oracle_path=2326000/instantclient-basic-linux.x64-23.26.0.0.0.zip ;; \
      arm64) oracle_path=2390000/instantclient-basic-linux.arm64-23.9.0.25.07.zip ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p "$DB_CLIENT" "$DM_HOME/bin"; \
    curl -fsSL --retry 3 -o /tmp/oracle.zip "https://download.oracle.com/otn_software/linux/instantclient/$oracle_path"; \
    unzip -q /tmp/oracle.zip -d "$DB_CLIENT"; \
    mv "$DB_CLIENT"/instantclient_* "$DB_CLIENT/oracle_instant_client"; \
    rm /tmp/oracle.zip; \
    validator="/usr/local/bin/validator_linux_$TARGETARCH"; \
    curl -fsSL --retry 3 --connect-timeout 60 --max-time 1800 \
        -o "$validator" "https://fit2cloud-support.oss-cn-beijing.aliyuncs.com/xpack-license/validator_linux_$TARGETARCH"; \
    chmod 0755 "$validator"; \
    ln -s "$validator" /usr/local/bin/validator_linux; \
    ln -s "$validator" /usr/local/bin/validator; \
    ln -s "$validator" /usr/bin/validator; \
    chmod g+xr /usr/bin/ld.so; \
    chmod g+x /usr/local/bin/python*
