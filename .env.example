# 复制为 .env 后再启动：cp .env.example .env
# 必填：JWT 签名密钥，请替换为随机值，例如 `openssl rand -hex 32` 的输出
SECRET_KEY=please-change-me

# 可选：MCP 返回图表图片时使用的地址，改成部署机器的 IP
# SERVER_IMAGE_HOST=http://<服务器IP>:8001/images/

# 可选：自动分析相关配置（以下为默认值）
# CHAT_AUTO_ANALYSIS_ENABLED=true
# ANALYSIS_SUPPLEMENTARY_QUERY_MAX=3
# ANALYSIS_PLAN_DATA_ROWS=50
# ANALYSIS_SUPPLEMENTARY_TIMEOUT=120
